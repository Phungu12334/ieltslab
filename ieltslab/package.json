{
  "name": "ieltslab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IELTS-style practice tests for Listening, Reading, Writing and Speaking. Not affiliated with IELTS.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/engine.test.ts tests/api.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
